rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Super-admin: verified email only
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'alan.pollock@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function accessDocId(coachUserId, readerUserId) {
      return coachUserId + '_' + readerUserId;
    }

    // Explicit grant: data_access/{coachUid}_{readerUid}
    function hasDataAccess(coachUserId) {
      return isSignedIn()
        && coachUserId != request.auth.uid
        && exists(/databases/$(database)/documents/data_access/$(accessDocId(coachUserId, request.auth.uid)));
    }

    function canReadUserData(userId) {
      return isSignedIn() && (
        request.auth.uid == userId
        || isAdmin()
        || hasDataAccess(userId)
      );
    }

    function validStateWrite() {
      return request.resource.data.keys().hasOnly(['data', 'updatedAt', 'forkedFrom', 'forkedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1500000
        && request.resource.data.updatedAt is number;
    }

    function validDataAccessGrant() {
      return request.resource.data.keys().hasAll(['coachUserId', 'readerUserId', 'grantedAt', 'via'])
        && request.resource.data.coachUserId is string
        && request.resource.data.readerUserId is string
        && request.resource.data.grantedAt is number
        && request.resource.data.via in ['share', 'admin', 'coach'];
    }

    function sessionCreateOwned() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email;
    }

    function sessionUpdateOwned() {
      return resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email;
    }

    function sessionDeleteAllowed() {
      return resource.data.userId == request.auth.uid
        || resource.data.get('sharedWith', '') == request.auth.token.email
        || isAdmin();
    }

    function canReadSession() {
      return isSignedIn() && (
        isAdmin()
        || resource.data.userId == request.auth.uid
        || resource.data.get('sharedWith', '') == request.auth.token.email
        || hasDataAccess(resource.data.userId)
      );
    }

    function validShareCreate() {
      return request.resource.data.keys().hasAll(['token', 'userId', 'userEmail', 'type', 'scope', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 32
        && request.resource.data.createdAt is number;
    }

    function validEmailGrant() {
      return request.resource.data.keys().hasAll(['readerEmail', 'grantedAt'])
        && request.resource.data.readerEmail is string
        && request.resource.data.readerEmail.size() > 3
        && request.resource.data.grantedAt is number;
    }

    match /users/{userId}/data/{document} {
      allow read: if canReadUserData(userId);
      allow create, update: if (isOwner(userId) || isAdmin()) && validStateWrite();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/sessions/{document} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/archives/{document} {
      allow read: if canReadUserData(userId);
      allow create, update: if (isOwner(userId) || isAdmin())
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1500000
        && request.resource.data.archivedAt is number;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Coach or admin invites a specific email to view this coach's data
    match /users/{userId}/email_grants/{grantId} {
      allow read: if isSignedIn() && (
        isOwner(userId)
        || isAdmin()
        || request.auth.token.email == resource.data.readerEmail
      );
      allow create: if (isOwner(userId) || isAdmin()) && validEmailGrant();
      allow delete: if isOwner(userId) || isAdmin();
      allow update: if false;
    }

    match /shares/{shareToken} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && (validShareCreate() || isAdmin());
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Explicit read grants for cross-user data access (share claim or email invite)
    match /data_access/{accessId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || request.auth.uid == resource.data.coachUserId
        || request.auth.uid == resource.data.readerUserId
      );

      allow create: if isSignedIn() && validDataAccessGrant()
        && accessId == accessDocId(request.resource.data.coachUserId, request.resource.data.readerUserId)
        && request.resource.data.coachUserId != request.resource.data.readerUserId
        && (
          // Recipient claims access via a valid share link
          (request.resource.data.readerUserId == request.auth.uid
            && request.resource.data.via == 'share'
            && request.resource.data.shareToken is string
            && get(/databases/$(database)/documents/shares/$(request.resource.data.shareToken)).data.userId
               == request.resource.data.coachUserId)
          // Recipient redeems an email invite from the coach or admin
          || (request.resource.data.readerUserId == request.auth.uid
            && request.resource.data.via == 'admin'
            && request.resource.data.grantId is string
            && get(/databases/$(database)/documents/users/$(request.resource.data.coachUserId)
                 /email_grants/$(request.resource.data.grantId)).data.readerEmail
               == request.auth.token.email)
          // Coach grants a specific user directly
          || (request.resource.data.via == 'coach'
            && request.resource.data.coachUserId == request.auth.uid)
          // Admin creates any grant
          || isAdmin()
        );

      allow delete: if isAdmin()
        || request.auth.uid == resource.data.coachUserId
        || request.auth.uid == resource.data.readerUserId;

      allow update: if false;
    }

    match /volleystat_sessions/{docId} {
      allow read: if canReadSession();
      allow create: if isSignedIn() && (isAdmin() || sessionCreateOwned());
      allow update: if isSignedIn() && (isAdmin() || sessionUpdateOwned());
      allow delete: if isSignedIn() && sessionDeleteAllowed();
    }

    match /volleystat_data/{deviceId} {
      allow read, write: if false;
    }

    match /admin_grants/{grantId} {
      allow read, write: if isAdmin();
    }
  }
}
